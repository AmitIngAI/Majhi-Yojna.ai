{
    "extends": ["react-app"],
    "rules": {
        "no-unused-vars": "off",
        "jsx-a11y/anchor-is-valid": "off",
        "react-hooks/exhaustive-deps": "off",
        "no-console": "off",
        "no-undef": "off",
        "react/jsx-no-undef": "off",
        "react/no-unescaped-entities": "off"
    }
}